[Unit]
Description=faber's Docker relay: vsock port 2375 to /run/docker.sock
Requires=faber-docker-vsock.socket docker.socket
After=faber-docker-vsock.socket docker.socket

[Service]
Type=simple
Restart=on-failure
RestartSec=1
ExecStart=/usr/local/libexec/faber-docker-relay
PrivateNetwork=yes
PrivateTmp=yes
NoNewPrivileges=yes
