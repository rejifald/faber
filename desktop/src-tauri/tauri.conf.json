{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "faber",
  "version": "0.3.12",
  "identifier": "io.github.rejifald.faber.menubar",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm --prefix ../ui run build && node scripts/assemble.mjs",
    "beforeDevCommand": {
      "script": "npm --prefix ../ui run build && node scripts/assemble.mjs",
      "wait": true
    }
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "macOS": {
      "infoPlist": "gen/build.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
