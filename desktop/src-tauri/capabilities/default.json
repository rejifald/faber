{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the faber popover. The panel window is named by no capability: it gets no IPC (ADR-0028 addendum C, decision 1)",
  "windows": ["popover"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "opener:default",
    "opener:allow-open-url"
  ]
}
